{
  "manifest_version": 3,
  "name": "ScentSaver — Arabian Perfume Alternative Finder",
  "version": "1.0.0",
  "description": "Find Arabian-inspired perfume alternatives for popular designer fragrances on ScentSaver.co.uk.",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Find ScentSaver Perfume Alternatives",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://scentsaver.co.uk/*",
    "https://*.scentsaver.co.uk/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}

